{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "cleanUrls": true,
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{build/**,node_modules/**,public/**,src/**,.git/**}"
    }
  }
}
